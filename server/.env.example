PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fifth_season_decor
DB_SSL=false

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=1d

# First admin user (created by `npm run db:migrate` if it does not exist)
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@fifthseasondecor.com
SEED_ADMIN_PASSWORD=Admin@123

# Google Sheet used by "Sync Google Sheet" (must be shared as "Anyone with the link can view").
# Optional — defaults are in src/config/sheets.js
# GOOGLE_SHEET_ID=1R_bq2G-bYiDYqgbzUk4ae1K-IzgkX_kngilRSpgzZko
# SHEET_TAB_CUT=Cut stock data
# SHEET_TAB_ROLL=roll stock data
# SHEET_TAB_IN_CHECKING=IN CHCECKING
# SHEET_TAB_CLIENTS=Client_master
# SHEET_TAB_TRANSPORT_PRIORITY=Transport Priority
# SHEET_TAB_TRANSPORTS=Transport Master

# AWS S3 — image uploads (inventory item images). Uploads are disabled until BUCKET is set.
# The bucket can stay PRIVATE (the API serves 1-hour signed URLs). IAM user needs
# s3:PutObject, s3:GetObject, s3:DeleteObject on arn:aws:s3:::<bucket>/inventory/*
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# Optional: S3-compatible endpoint (MinIO, Cloudflare R2, local testing)
# AWS_S3_ENDPOINT=
